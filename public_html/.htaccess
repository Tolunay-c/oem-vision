# OEM Vision — canlı sunucu ayarları
Options -Indexes
DirectoryIndex index.html index.php

RewriteEngine On
RewriteBase /

# ---- Dışarıya kapalı dosya ve klasörler ----
RewriteRule ^data(/.*)?$ - [F,L]
RewriteRule ^_cms/(?!serve\.php$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(bak|log|sql|zip|md)$ - [F,L,NC]

# ---- Ana sayfa -> Türkçe ----
RewriteRule ^(index\.html)?$ /tr/ [R=302,L]

# ---- Site sayfaları panel bağlantı katmanından geçer ----
RewriteRule ^(tr|en)(/.*)?$ _cms/serve.php [L,QSA]

ErrorDocument 404 /_cms/serve.php

# ---- Önbellek ----
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
  </FilesMatch>
  # Panelden değiştirilebilen dosyalar: tarayıcı her seferinde değişip değişmediğini sorar
  <FilesMatch "\.(png|jpe?g|webp|gif|pdf|ico)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Next.js dosyaları adlarında sürüm taşıdığı için uzun süre önbelleklenebilir
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
